---
import Site from '../../layouts/Site.astro';
import { dekText, renderPost } from '@/lib/site/post-render';
import { type PostMeta, fmtDate, getPosts, isoDate } from '@/lib/site/posts';

/* The body comes from the same renderer the Next app uses (lib/site/post-render.ts): code blocks with
   filename bars and marked lines, callouts, pull quotes, figures, tables, tweets. Its markup is styled
   in src/styles/column.css under "Post body components". */

export function getStaticPaths() {
    const all = getPosts();
    return all.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
    post: PostMeta;
}
const { post: p } = Astro.props;
const all = getPosts(); /* newest first */
const { html } = renderPost(p, all);

const i = all.findIndex((x) => x.slug === p.slug);
const newer = all[i - 1];
const older = all[i + 1];
const AVATAR = 'https://res.cloudinary.com/jaeyholic/image/upload/fl_lossy,f_auto,q_auto,w_120/felixyeboah.dev/IMG_7337_tmsrzq';
---

<Site title={p.title} description={dekText(p) || undefined} section="writing">
    <article aria-labelledby="post-title">
        <header class="page-head post-head">
            <a class="crumb" href="/writing">
                <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M8.5 3.5L5 7l3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>Writing
            </a>
            <h1 id="post-title">{p.title}</h1>
            <ul class="meta-line">
                <li><time class="mono" datetime={isoDate(p.date)}>{fmtDate(p.date)}</time></li>
                {p.minutes > 0 && <li>{p.minutes} min read</li>}
            </ul>
        </header>

        <div class="prose post-body" set:html={html} />

        <footer class="post-author">
            <img class="avatar" src={AVATAR} width="40" height="40" alt="" loading="lazy" />
            <span class="name">Felix Yeboah</span>
            <a class="link" href="https://x.com/sudocode_">@sudocode_ on X</a>
        </footer>
    </article>

    <nav class="pager post-pager" aria-label="More writing">
        {older ? (
            <a href={`/writing/${older.slug}`} rel="prev">
                <span class="dir">Previous</span>
                <span class="name"><span class="u">{older.title}</span></span>
            </a>
        ) : <span />}
        {newer ? (
            <a href={`/writing/${newer.slug}`} rel="next">
                <span class="dir">Next</span>
                <span class="name"><span class="u">{newer.title}</span></span>
            </a>
        ) : <span />}
    </nav>
    <p class="post-all"><a class="link" href="/writing">All writing</a></p>
</Site>

<style is:global>
    .post-head h1 { text-wrap: balance; }
    .post-body { margin-top: var(--s-7); }
    .post-body > :first-child { margin-top: 0; }
    .post-body hr + h2 { margin-top: var(--s-7); }
    .post-body h2, .post-body h3 { scroll-margin-top: var(--s-5); text-wrap: balance; }

    .post-author {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--s-1) var(--s-3);
        margin-top: var(--s-8);
        padding-top: var(--s-5);
        border-top: 1px solid var(--hair);
        font-size: var(--t-sm);
    }
    .post-author .name { font-weight: 600; margin-right: var(--s-1); }
    .post-author .link { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted); }

    .post-pager { margin-top: var(--s-7); }
    .post-all { margin-top: var(--s-5); }
    .post-all .link { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--t-sm); }

    @media (max-width: 640px) {
        .post-body { margin-top: var(--s-6); }
        .post-body > h2 { margin-top: var(--s-7); }
        .post-body hr + h2 { margin-top: var(--s-6); }
        .post-body hr { margin-top: var(--s-6); }
    }
</style>

<script is:inline>
    /* Copy buttons on code blocks; hidden where the clipboard is unavailable. */
    document.querySelectorAll('.code').forEach(function (fig) {
        var b = fig.querySelector('.code__copy'), pre = fig.querySelector('pre');
        if (!b || !pre) return;
        if (!navigator.clipboard) { b.hidden = true; return; }
        b.addEventListener('click', function () {
            var text = [].map.call(pre.querySelectorAll('.l'), function (l) { return l.textContent; }).join('\n') || pre.textContent;
            navigator.clipboard.writeText(text).then(function () {
                b.classList.add('is-done');
                b.querySelector('span').textContent = 'Copied';
                setTimeout(function () { b.classList.remove('is-done'); b.querySelector('span').textContent = 'Copy'; }, 1600);
            });
        });
    });
</script>
