---
import '../styles/fonts.css';
import '../styles/chrome.css';
import sansFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import '../styles/column.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Meta from '../components/Meta.astro';

interface Props {
    title?: string;
    description?: string;
    /** which nav item is the current page */
    section?: 'work' | 'writing' | 'about' | 'photos';
    /** pages that keep search engines out (404) */
    noindex?: boolean;
    /** link-preview image, as a path on this site; defaults to the site card */
    image?: string;
    imageAlt?: string;
    /** posts are articles to link previews */
    type?: 'website' | 'article';
}

const NAME = 'Felix Yeboah - Jefferson';
const { title, description = 'Software engineer & UI/UX designer in Accra.', section, noindex, image, imageAlt, type } = Astro.props;
const fullTitle = title ? `${title} — ${NAME}` : `${NAME} — Software engineer & UI/UX designer`;
/* build.format 'file' names the home page /index; the public URL is / */
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/', Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
        {!noindex && <Meta title={fullTitle} description={description} url={canonical.href} image={image} imageAlt={imageAlt} type={type} />}
        <link rel="alternate" type="application/rss+xml" href="https://felixyeboah.dev/writing/feed.xml" />
        <!-- ?v= forces browsers to drop a cached icon; raise it whenever the logo changes -->
        <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
        <link rel="icon" href="/favicon.ico?v=3" sizes="256x256" type="image/x-icon" />
        <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
        <slot name="head" />
    </head>
    <body>
        <a class="skip" href="#main">Skip to content</a>
        <div class="column">
            <Header section={section} />

            <main id="main">
                <slot />
            </main>

            <Footer />
        </div>
    </body>
</html>
