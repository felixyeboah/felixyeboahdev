---
import Site from '../layouts/Site.astro';

const LINKS = [
    ['Home', '/'],
    ['Work', '/work'],
    ['Writing', '/writing'],
    ['Email', 'mailto:me@felixyeboah.dev'],
];
---

<Site title="Page not found" noindex>
    <section class="page-head" aria-labelledby="nf-title">
        <p class="mono muted">404</p>
        <h1 id="nf-title">Page not found</h1>
    </section>
    <section aria-label="Where to go">
        <ul class="ruled">
            {LINKS.map(([label, href]) => (
                <li>
                    <a class="post" href={href}>
                        <span class="title"><span class="u">{label}</span></span>
                        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
                            <path d="M4 10L10 4M5 4h5v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </li>
            ))}
        </ul>
    </section>
</Site>
