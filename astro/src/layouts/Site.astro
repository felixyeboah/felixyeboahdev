---
import '../styles/column.css';

interface Props {
    title?: string;
    description?: string;
    /** which nav item is the current page */
    section?: 'work' | 'writing' | 'about' | 'photos';
    /** pages that keep search engines out (404) */
    noindex?: boolean;
}

const NAME = 'Felix Yeboah';
const { title, description = 'Software engineer & UI/UX designer in Accra.', section, noindex } = Astro.props;
const fullTitle = title ? `${title} — ${NAME}` : `${NAME} — Software engineer & UI/UX designer`;
/* build.format 'file' names the home page /index; the public URL is / */
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/', Astro.site);
const NAV = [
    ['work', 'Work', '/work'],
    ['writing', 'Writing', '/writing'],
    ['about', 'About', '/about'],
    ['photos', 'Photos', '/photos'],
] as const;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
        <link rel="alternate" type="application/rss+xml" href="https://felixyeboah.dev/writing/feed.xml" />
        <!-- ?v= forces browsers to drop a cached icon; raise it whenever the logo changes -->
        <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
        <link rel="icon" href="/favicon.ico?v=3" sizes="256x256" type="image/x-icon" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <slot name="head" />
    </head>
    <body>
        <a class="skip" href="#main">Skip to content</a>
        <div class="column">
            <header class="site-header">
                <a class="identity" href="/" aria-label="Felix Yeboah, home">
                    <svg class="logo" viewBox="0 0 128 128" width="40" height="40" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="10" y="26" width="108" height="76" rx="13" />
                        <path class="logo-eye" d="M 31 51 L 46 64 L 31 77" />
                        <path class="logo-grin" d="M 62 67 C 68 75 80 75 86 67" />
                    </svg>
                </a>
                <nav class="nav" aria-label="Primary">
                    <ul>
                        {NAV.map(([key, label, href]) => (
                            <li>
                                <a href={href} aria-current={section === key ? 'page' : undefined}>{label}</a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </header>

            <main id="main">
                <slot />
            </main>

            <footer class="site-footer">
                <a class="footer-email" href="mailto:me@felixyeboah.dev"><span class="u">me@felixyeboah.dev</span></a>
                <div class="footer-links">
                    <a href="https://github.com/felixyeboah">GitHub</a>
                    <a href="https://x.com/sudocode_">X</a>
                    <a href="/resume">Résumé</a>
                    <a href="/photos">Photos</a>
                    <span class="copy">© {new Date().getFullYear()}</span>
                </div>
            </footer>
        </div>
    </body>
</html>
