---
import Site from '../../layouts/Site.astro';
import { cld } from '@/lib/site/posts';
import { type GalleryItem, type Rich, type Title, getDetail } from '@/lib/site/project-details';
import { PROJECTS, type Project, pad2 } from '@/lib/site/projects';

/* One template for every project. Each block is optional and renders only when the project has it
   (lib/site/project-details.ts documents the blocks). The route diagram, a bespoke React component on
   the old site, is not carried over. */

export function getStaticPaths() {
    return PROJECTS.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
    project: Project;
}
const { project: p } = Astro.props;
const d = getDetail(p.slug);
if (!d) throw new Error(`No project detail for ${p.slug}`);

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
/* Rich = 'text' | Array<'text' | { text, href }>; hrefs are internal routes */
const rich = (r: Rich) =>
    typeof r === 'string' ? esc(r) : r.map((x) => (typeof x === 'string' ? esc(x) : `<a href="${esc(x.href)}">${esc(x.text)}</a>`)).join('');
const plain = (t: Title | string[]) => (typeof t === 'string' ? t : t.join(' '));

const tagline = plain(d.tagline);
const stage = { src: p.cover, w: 1600, h: 1000, ...d.stage };
const stageCap = (d.stage.cap ?? [`${p.domain} · homepage`, '']).filter(Boolean).join('. ');

const credits = [
    ...(d.credits?.some((c) => c.k === 'Category') ? [] : [{ k: 'Category', v: p.category }]),
    ...(d.credits ?? []),
    ...(d.formerly ? [{ k: 'Formerly', v: d.formerly }] : []),
];

/* chapter screenshots show the data's crop [x, y, w, h], given as fractions of the capture */
const SHOT = { w: 2160, h: 1350 };
const cropStyle = (c: [number, number, number, number]) =>
    `--x:${c[0]};--y:${c[1]};--w:${c[2]};--h:${c[3]};aspect-ratio:${Math.round(SHOT.w * c[2])} / ${Math.round(SHOT.h * c[3])}`;

const galleryImg = (it: GalleryItem) =>
    it.id
        ? { src: cld(it.id, 1600), srcset: `${cld(it.id, 800)} 800w, ${cld(it.id, 1600)} 1600w, ${cld(it.id, 2400)} 2400w` }
        : { src: it.src as string, srcset: it.srcSet };
const full = (it: GalleryItem) => it.wide || (it.span ?? 6) >= 12;

const i = PROJECTS.findIndex((x) => x.slug === p.slug);
const prev = PROJECTS[(i - 1 + PROJECTS.length) % PROJECTS.length];
const next = PROJECTS[(i + 1) % PROJECTS.length];
---

<Site title={`${p.name}: ${d.rich ? 'Case study' : p.category}`} description={d.description ?? p.desc} section="work">
    <section class="page-head">
        <a class="crumb" href="/work">
            <svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M8.5 3.5L5 7l3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>Work
        </a>
        <h1>{p.name}</h1>
        <p class="lede">{tagline}</p>
    </section>

    <section class="case-intro" aria-label="Overview">
        <figure class="figure case-hero">
            <span class="frame">
                <img src={stage.src} width={stage.w} height={stage.h} alt={stage.alt} loading="eager" fetchpriority="high" />
            </span>
            <figcaption>{stageCap}</figcaption>
        </figure>

        <ul class="ruled case-credits">
            {credits.map((c) => (
                <li class="kv">
                    <span class="k">{c.k}</span>
                    <span class="v">
                        {c.v}
                        {c.note && <span class="case-credit-note">{c.note}</span>}
                    </span>
                </li>
            ))}
            <li class="kv">
                <span class="k">Live</span>
                <span class="v"><a class="link mono" href={p.url} rel="noopener">{p.domain}</a></span>
            </li>
        </ul>
    </section>

    {d.brief && (
        <section class="case-brief" aria-label="The brief">
            <p class="case-statement">
                {d.brief.statement} {d.brief.muted && <span class="muted">{d.brief.muted}</span>}
            </p>
            {d.brief.story && (
                <div class="prose">
                    {d.brief.story.map((col) => (
                        <>
                            <h2>{col.h}</h2>
                            {col.body?.map((b) => <p set:html={rich(b)} />)}
                            {col.list && (
                                <ul>
                                    {col.list.map((li) => (
                                        <li>
                                            {li.b && <strong>{li.b} </strong>}
                                            {li.t}
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </>
                    ))}
                </div>
            )}
        </section>
    )}

    {d.chapters && (
        <section class="case-chapters" aria-label={d.chapters.label}>
            <div class="prose">
                {d.chapters.items.map((c) => (
                    <>
                        <h2>{c.title}</h2>
                        <p>{c.body}</p>
                        <figure class="figure">
                            <span class={c.crop ? 'frame case-crop' : 'frame'} style={c.crop ? cropStyle(c.crop) : undefined}>
                                <img src={c.src} width={SHOT.w} height={SHOT.h} alt={c.alt} loading="lazy" decoding="async" />
                            </span>
                            <figcaption>{[c.cap, c.note].filter(Boolean).join(' · ')}</figcaption>
                        </figure>
                    </>
                ))}
            </div>
        </section>
    )}

    {d.compose && (
        <section aria-labelledby="compose-title">
            <h2 id="compose-title">{d.compose.label}</h2>
            <figure class="figure case-phone">
                <span class="frame">
                    <img src={d.compose.mobile} width="780" height="1688" alt={d.compose.alt} loading="lazy" decoding="async" />
                </span>
                <figcaption>
                    <span class="case-phone-title">{plain(d.compose.title)}</span>
                    {d.compose.cap[0]}
                </figcaption>
            </figure>
        </section>
    )}

    {d.notes && (
        <section aria-labelledby="notes-title">
            <h2 id="notes-title">{d.notes.label}</h2>
            <ul class="ruled">
                {d.notes.items.map((n, k) => (
                    <li class="case-note">
                        <span class="num mono">{pad2(k + 1)}</span>
                        <span>
                            <span class="t">{n.t}</span>
                            <span class="b">{n.b}</span>
                        </span>
                    </li>
                ))}
            </ul>
            {d.notes.chips && (
                <ul class="case-tags" aria-label={d.notes.chipsLabel}>
                    {d.notes.chips.map((c) => <li class="tag">{c}</li>)}
                </ul>
            )}
        </section>
    )}

    {d.gallery && (
        <section aria-labelledby="gallery-title">
            <h2 id="gallery-title">{d.gallery.label}</h2>
            <div class="case-gallery">
                {d.gallery.items.map((it) => {
                    const img = galleryImg(it);
                    return (
                        <figure class:list={['figure', { 'is-full': full(it) }]}>
                            <span class="frame">
                                <img
                                    src={img.src}
                                    srcset={img.srcset}
                                    sizes={img.srcset ? (full(it) ? '(min-width: 1100px) 1000px, 100vw' : '(min-width: 640px) 360px, 100vw') : undefined}
                                    width={it.w}
                                    height={it.h}
                                    alt={it.alt}
                                    loading="lazy"
                                    decoding="async"
                                />
                            </span>
                            <figcaption>{[it.cap, it.note].filter(Boolean).join(' · ')}</figcaption>
                        </figure>
                    );
                })}
            </div>
        </section>
    )}

    {d.facts && (
        <section aria-labelledby="facts-title">
            <h2 id="facts-title">{d.facts.label}</h2>
            <ul class="ruled">
                {d.facts.items.map((f) => (
                    <li class="kv case-fact">
                        <span class="mono">{[f.pre, f.v, f.unit].filter(Boolean).join(' ')}</span>
                        <span>
                            <span class="l">{f.l}</span>
                            {f.p && <span class="b">{f.p}</span>}
                        </span>
                    </li>
                ))}
            </ul>
            {d.facts.status && (
                <>
                    <h3>{d.facts.status.listTitle}</h3>
                    <ul class="ruled">
                        {d.facts.status.list.map((s) => (
                            <li class="case-status">
                                <span set:html={rich(s.t)} />
                                <span class="mono muted">{s.tag}</span>
                            </li>
                        ))}
                    </ul>
                </>
            )}
        </section>
    )}

    {d.quote && (
        <section aria-label={d.quote.label}>
            <figure class="case-quote prose">
                <blockquote>
                    <p>{d.quote.text}{d.quote.em && ` ${d.quote.em}`}</p>
                </blockquote>
                <figcaption>{d.quote.by} · {d.quote.role}</figcaption>
            </figure>
        </section>
    )}

    <nav class="pager" aria-label="Projects">
        <a href={`/work/${prev.slug}`} rel="prev">
            <span class="dir">Previous</span>
            <span class="name"><span class="u">{prev.name}</span></span>
        </a>
        <a href={`/work/${next.slug}`} rel="next">
            <span class="dir">Next</span>
            <span class="name"><span class="u">{next.name}</span></span>
        </a>
    </nav>
    <p class="case-all"><a class="link" href="/work">All work</a></p>
</Site>

<style is:global>
    /* hero and full-width gallery images bleed to 1000px once there is room; column width below that */
    .case-intro { margin-top: var(--s-7); }
    .case-hero .frame { aspect-ratio: 16 / 10; }
    .case-hero .frame img { height: 100%; object-fit: cover; object-position: top center; }
    @media (min-width: 1100px) {
        .case-hero, .case-gallery .is-full { margin-inline: -140px; }
        .case-hero figcaption, .case-gallery .is-full figcaption { margin-inline: 140px; }
    }
    .case-credits { margin-top: var(--s-6); }
    .case-credits a { padding-block: var(--s-3); }
    .case-credit-note { display: block; font-weight: 400; color: var(--muted); }

    .case-statement { font-size: var(--t-lg); line-height: 1.5; letter-spacing: -0.008em; max-width: 36em; text-wrap: pretty; }
    .case-brief .prose, .case-chapters .prose { margin-top: var(--s-2); }
    .case-brief .case-statement + .prose { margin-top: var(--s-7); }
    .prose > .figure { margin-top: var(--s-6); }

    /* chapter screenshots: the crop [x, y, w, h] arrives as custom properties on the frame */
    .case-crop { position: relative; overflow: hidden; }
    .figure .case-crop img { position: absolute; max-width: none; width: calc(100% / var(--w)); height: auto; left: calc(-100% * var(--x) / var(--w)); top: calc(-100% * var(--y) / var(--h)); }

    /* the phone capture sits beside its caption; stacked on small screens */
    .case-phone { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: var(--s-6); align-items: end; }
    .case-phone figcaption { margin: 0 0 var(--s-2); max-width: 22em; }
    .case-phone-title { display: block; margin-bottom: var(--s-1); font-size: var(--t-md); font-weight: 600; color: var(--ink); }

    .case-note { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); column-gap: var(--s-3); align-items: baseline; padding: var(--s-4) 0; }
    .case-note .num { color: var(--muted); }
    .case-note .t { display: block; font-weight: 600; }
    .case-note .b, .case-fact .b { display: block; margin-top: var(--s-1); color: var(--muted); text-wrap: pretty; }
    .case-fact .l { display: block; font-weight: 600; }
    .case-tags { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-5); }
    .case-status { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); padding: var(--s-3) 0; min-height: 48px; }
    .case-status a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: #C9C8C1; }

    .case-gallery { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-6) var(--s-5); }
    .case-gallery .is-full { grid-column: 1 / -1; }

    .case-quote { margin: 0; }
    .case-quote blockquote { margin: 0; }
    .case-quote figcaption { margin-top: var(--s-4); padding-left: var(--s-5); font-size: var(--t-sm); color: var(--muted); }

    .case-all { margin-top: var(--s-5); font-size: var(--t-sm); }
    .case-all a { display: inline-flex; align-items: center; min-height: 44px; }

    @media (max-width: 640px) {
        .case-gallery { grid-template-columns: 1fr; }
        .case-phone { grid-template-columns: minmax(0, 200px); }
    }
</style>
